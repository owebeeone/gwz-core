    "publication": ["presence", "step", "candidate", "composition", "hashes", "root_merge", "evidence_rolled_back", "root_preservation", "preservation_prefix"],
    "observation": ["participants", "root", "preservation", "rollback"],
    "participant_observation": ["id", "action", "head", "target_ref", "index", "worktree"]
  },
