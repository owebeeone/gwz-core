.DS_Store
.venv/
/protocol/.regen-venv/
__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.pyc
build/
dist/
*.egg-info/
tests/.uv-venvs/
tests/actual_test_results/
scratch/
*-old.py

# Rust (Cargo) build output
/target

# Bazel/Razel convenience symlinks and caches
bazel-*
/razel-out
/razel-bin
/razel-testlogs
.claude/
.razel-cache/

# Compiled Rust artifacts left in the tree
*.rlib

# LCM1.0c: a library under crates/ run as its own root from a standalone core
# checkout (`cargo test --manifest-path crates/<dir>/Cargo.toml --lib`) gets a
# per-crate lock and target; neither is tracked.
/crates/*/Cargo.lock
/crates/*/target/
