{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owebeeone/gwz-core/blob/main/scripts/retained_readers/cases.schema.json",
  "title": "GWZ retained-reader behavioral cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "gwz.retained-reader-cases/v1" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value"],
      "properties": {
        "mode": { "enum": ["exact", "normalized-exact", "contains", "json", "jsonl", "json-contract"] },
        "value": {}
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "json-contract" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/jsonContract" } } }
        }
      ]
    },
    "jsonContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "outcomes", "merge_id", "member_id", "member_outcomes"],
          "properties": {
            "shape": { "const": "merge" },
            "outcomes": { "$ref": "#/$defs/nonemptyStrings" },
            "merge_id": { "type": "string", "minLength": 1 },
            "member_id": { "type": "string", "minLength": 1 },
            "member_outcomes": { "$ref": "#/$defs/nonemptyStrings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "outcomes", "member_id", "member_outcomes"],
          "properties": {
            "shape": { "const": "workspace-status" },
            "outcomes": { "$ref": "#/$defs/nonemptyStrings" },
            "member_id": { "type": "string", "minLength": 1 },
            "member_outcomes": { "$ref": "#/$defs/nonemptyStrings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "outcomes", "member_id"],
          "properties": {
            "shape": { "const": "legacy-branch" },
            "outcomes": { "$ref": "#/$defs/nonemptyStrings" },
            "member_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "outcomes"],
          "properties": {
            "shape": { "const": "error" },
            "outcomes": { "$ref": "#/$defs/nonemptyStrings" }
          }
        }
      ]
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paths"],
          "properties": {
            "mode": { "const": "exact" },
            "paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed"],
          "properties": {
            "mode": { "const": "allow" },
            "allowed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "exact", "dynamic"],
          "properties": {
            "mode": { "const": "contract" },
            "exact": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "dynamic": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern", "minimum", "maximum"],
                "properties": {
                  "pattern": { "type": "string", "minLength": 1 },
                  "minimum": { "type": "integer", "minimum": 0 },
                  "maximum": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_codes", "mutation"],
      "properties": {
        "exit_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" },
          "uniqueItems": true
        },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "mutation": { "$ref": "#/$defs/mutation" },
        "before_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "after_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "postcondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "state"],
          "properties": {
            "kind": { "const": "path" },
            "path": { "type": "string", "minLength": 1 },
            "state": { "enum": ["file", "directory", "absent"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "left", "right"],
          "properties": {
            "kind": { "const": "git-ref-equals" },
            "repository": { "type": "string", "minLength": 1 },
            "left": { "type": "string", "minLength": 1 },
            "right": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "ref", "value"],
          "properties": {
            "kind": { "const": "git-commit-message" },
            "repository": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "ref", "count"],
          "properties": {
            "kind": { "const": "git-parent-count" },
            "repository": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "before", "after", "fields"],
          "properties": {
            "kind": { "const": "merge-record-baseline-preserved" },
            "before": { "type": "string", "minLength": 1 },
            "after": { "type": "string", "minLength": 1 },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": { "const": "snapshot-entries-unchanged" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "sha256", "required"],
          "properties": {
            "kind": { "const": "yaml-semantic" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "normalize_dynamic": { "type": "boolean" },
            "semantic": { "enum": ["yaml", "merge-record"] },
            "required": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern", "count", "sha256"],
          "properties": {
            "kind": { "const": "yaml-set-semantic" },
            "pattern": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 0 },
            "sha256": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "branch", "parent", "message", "sha256"],
          "properties": {
            "kind": { "const": "root-publication" },
            "repository": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "parent": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "message": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "sha256"],
          "properties": {
            "kind": { "const": "git-index-semantic" },
            "repository": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "envelopeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "record_schema_version", "open_fixture", "open_fixture_sha256", "archived_fixture", "archived_fixture_sha256"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "record_schema_version": { "type": "integer", "minimum": 0 },
        "open_fixture": { "type": "string", "minLength": 1 },
        "open_fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archived_fixture": { "type": "string", "minLength": 1 },
        "archived_fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ordinaryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "readers", "command", "args", "fixture", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "readers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fixture": { "type": "string", "minLength": 1 },
        "fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "projection": { "enum": ["human", "json", "jsonl"] },
        "lifecycle": { "enum": ["open-start", "open-status", "open-continue", "open-abort", "open-preserve", "archived-status", "archived-targeted-gc", "archived-retention-gc"] },
        "record_schema": { "type": "string", "minLength": 1 },
        "record_schema_version": { "type": "integer", "minimum": 0 },
        "classification": { "enum": ["record_unreadable", "retention_noop"] },
        "known_incompatibility": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/expected" },
        "postconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/postcondition" }
        }
      }
    },
    "envelopeMatrixCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "readers", "envelopes", "expectations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "readers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "envelopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/envelopeDescriptor" }
        },
        "expectations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/expected" }
        }
      }
    },
    "case": {
      "oneOf": [
        { "$ref": "#/$defs/ordinaryCase" },
        { "$ref": "#/$defs/envelopeMatrixCase" }
      ]
    }
  }
}
