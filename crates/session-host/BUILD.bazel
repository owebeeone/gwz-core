load("@rules_rust//rust:defs.bzl", "rust_library")
load("@gwz_core_crates//:defs.bzl", "aliases", "all_crate_deps")

exports_files(["Cargo.toml"])  # crate_universe (the @gwz_core_crates hub) reads this

# gwz-session-host — GWZ core session: the session host's operation gates, session limits and supervisor.
# A member of gwz-core's own Cargo workspace (see //gwz-core:BUILD.bazel): third-party deps
# resolve from //gwz-core:Cargo.lock through @gwz_core_crates; first-party deps are the sibling
# members listed by label, mirroring [dependencies] in Cargo.toml (the allowed edges are owned
# by gwz-core/scripts/checks/check_local_clone_boundaries.py). The `test-support` feature is
# gwz-core's dev-only hook and is not built here.
rust_library(
    name = "gwz_session_host",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//gwz-core/crates/session-contract:gwz_session_contract",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//gwz-core:__subpackages__"],
)
